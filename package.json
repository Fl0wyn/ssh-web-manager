{
  "name": "ssh-web-manager",
  "version": "0.1.0",
  "description": "Interface web locale pour parcourir les hosts de ~/.ssh/config et ouvrir des sessions SSH interactives dans le navigateur.",
  "private": true,
  "scripts": {
    "dev": "concurrently -n next,ws -c blue,magenta \"npm:dev:next\" \"npm:dev:ws\"",
    "dev:next": "next dev -p 9100",
    "dev:ws": "tsx watch ws-server/index.ts",
    "build": "next build",
    "start": "concurrently -n next,ws -c blue,magenta \"npm:start:next\" \"npm:start:ws\"",
    "start:next": "next start -p 9100",
    "start:ws": "tsx ws-server/index.ts",
    "lint": "eslint"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.2.4",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "ssh-config": "^5.0.3",
    "ssh2": "^1.17.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/ssh2": "^1.15.5",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4.2.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.3"
  }
}
